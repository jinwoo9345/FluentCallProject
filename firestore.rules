rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isTutor() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'tutor';
    }

    // 신규 이메일 가입자만 이메일 인증을 요구한다.
    // 기존 사용자(필드 없음)와 Google/Kakao 가입자(false)는 기존처럼 이용 가능하다.
    function hasVerifiedEmailIfRequired() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('emailVerificationRequired', false) == false
          || request.auth.token.get('email_verified', false) == true
        );
    }

    // 금전성 잔액 변경은 서버 트랜잭션 또는 관리자 조정만 허용한다.

    // 신규 가입자는 반드시 최소 권한(student)과 0 포인트로 시작해야 한다.
    // 클라이언트가 임의 필드를 추가해 관리자 권한이나 금전성 값을 주입하지 못하도록
    // 가입 시 사용하는 필드도 명시적으로 제한한다.
    function validUserCreate(userId) {
      return request.auth.uid == userId
        && request.resource.data.keys().hasAll([
          'uid', 'name', 'realName', 'email', 'role', 'credits',
          'referralCode', 'referredBy', 'discountBalance', 'createdAt',
          'avatar', 'agreedToTermsAt', 'agreedToPrivacyAt',
          'marketingOptIn', 'marketingOptInAt', 'emailVerificationRequired'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'realName', 'email', 'role', 'credits',
          'referralCode', 'referredBy', 'discountBalance', 'createdAt',
          'avatar', 'hasCompletedConsultation',
          'agreedToTermsAt', 'agreedToPrivacyAt',
          'marketingOptIn', 'marketingOptInAt', 'tutorApplicationStatus',
          'emailVerificationRequired'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.role == 'student'
        && request.resource.data.credits == 0
        && request.resource.data.discountBalance == 0
        && request.resource.data.name is string
        && request.resource.data.realName is string
        && request.resource.data.email is string
        && request.resource.data.referralCode is string
        && request.resource.data.referredBy is string
        && request.resource.data.avatar is string
        && request.resource.data.marketingOptIn is bool
        && request.resource.data.emailVerificationRequired is bool
        && request.resource.data.emailVerificationRequired
          == (request.auth.token.firebase.sign_in_provider == 'password');
    }

    // 본인이 바꿀 수 있는 값은 화면에서 제공하는 비권한성 프로필/상태 필드뿐이다.
    // role, credits, discountBalance, referralCode 같은 권한·금전성 필드는 포함하지 않는다.
    function ownProfileUpdateOnly(userId) {
      return request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'realName', 'email', 'avatar', 'wishlist',
          'hasCompletedConsultation', 'tutorApplicationId',
          'marketingOptIn', 'marketingOptInAt'
        ]);
    }

    // 유저 정보
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if isSignedIn() && validUserCreate(userId);

      // 일반 회원은 프로필만 변경. 포인트·선물·결제는 인증된 서버에서 처리.
      allow update: if isSignedIn() && (
        isAdmin()
        || ownProfileUpdateOnly(userId)
      );
      allow delete: if isAdmin();
    }

    // 닉네임 유니크 인덱스 — 문서 ID = 닉네임 소문자(키), 한 유저당 하나만 점유
    // - read 공개: 신규 가입/변경 시 사전 중복 검사용
    // - create: 본인 uid 만 자기 닉네임 doc 생성. 길이 2~30
    // - delete: 본인(닉네임 변경 시 이전 doc 해제) 또는 관리자
    match /nicknames/{nickname} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && nickname.size() >= 2 && nickname.size() <= 30;
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // 추천 코드 인덱스
    // 코드 포맷 강제 + 덮어쓰기 방지 + 본인 uid 검증
    match /referral_codes/{code} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && !exists(/databases/$(database)/documents/referral_codes/$(code))
        && code.size() >= 4 && code.size() <= 16
        && code.matches('^[A-Z0-9]+$');
      allow delete: if isAdmin();
    }

    // 포인트 이체 내역
    // fromName은 실제 송신자 이름과 일치해야 (피싱 방지), amount는 양의 정수
    match /point_transfers/{transferId} {
      allow create, update, delete: if false;
      allow read: if isSignedIn() && (
        resource.data.fromId == request.auth.uid
        || resource.data.toId == request.auth.uid
        || isAdmin()
      );
    }

    // 관리자 지급/회수 로그. 잔액 변경과 함께 생성하며 수정·삭제는 허용하지 않는다.
    match /point_adjustments/{adjustmentId} {
      allow read: if isAdmin();
      allow update, delete: if false;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'userId', 'userName', 'adminId', 'adminName', 'delta',
          'before', 'after', 'reason', 'createdAt'
        ])
        && request.resource.data.userId is string
        && request.resource.data.userName is string
        && request.resource.data.adminId == request.auth.uid
        && request.resource.data.adminName is string
        && request.resource.data.delta is int
        && request.resource.data.delta != 0
        && request.resource.data.before is int
        && request.resource.data.before >= 0
        && request.resource.data.after is int
        && request.resource.data.after >= 0
        && request.resource.data.after == request.resource.data.before + request.resource.data.delta
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 300
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/users/$(request.resource.data.userId)).data.get('credits', 0) == request.resource.data.before
        && getAfter(/databases/$(database)/documents/users/$(request.resource.data.userId)).data.credits == request.resource.data.after;
    }

    // 서버가 생성하는 결제 사용·반환·보상 원장. 클라이언트 수정 금지.
    match /point_ledger/{entryId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // 튜터 목록
    match /tutors/{tutorId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == tutorId);
    }

    // 수업 세션
    // - 읽기: 본인(userId)·강사(tutorId)·관리자
    // - 등록(create): 관리자 / 또는 강사 본인이 tutorId == self 로 등록 (자기 자신을 강사로만 지정 가능)
    // - 수정·삭제: 관리자 / 또는 해당 수업의 강사 본인
    match /sessions/{sessionId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid
        || resource.data.tutorId == request.auth.uid
        || isAdmin()
      );
      allow create: if isAdmin()
        || (isTutor()
          && request.resource.data.tutorId == request.auth.uid
          && request.resource.data.status == 'upcoming'
          && request.resource.data.userId is string
          && request.resource.data.userId.size() > 0
          && request.resource.data.duration is int
          && request.resource.data.duration > 0
          && request.resource.data.duration <= 240);
      allow update: if isAdmin()
        || (isTutor() && resource.data.tutorId == request.auth.uid);
      allow delete: if isAdmin()
        || (isTutor() && resource.data.tutorId == request.auth.uid);
    }

    // 개인 일정 - 소유자만 CRUD, 관리자는 전체 읽기
    // 사용자가 자신의 달력에 직접 입력하는 일정 (수업과 무관)
    match /personal_events/{eventId} {
      allow read: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid
        || isAdmin()
      );
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200;
      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }

    // 상담 신청 - 비로그인 create 허용
    // 미할당 상담(userId==null)만 로그인 사용자가 자신에게 연결 가능 (consultationId는
    // Firestore 자동 ID 20자라 모르는 유저가 claim 시도 불가). 다른 필드 변경은 관리자만.
    match /consultations/{consultationId} {
      allow create: if true;
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin()
        || (isSignedIn()
          && resource.data.userId == null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userId']));
      allow delete: if isAdmin();
    }

    // 강사 신청
    match /tutor_applications/{appId} {
      allow create: if hasVerifiedEmailIfRequired()
        && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid
        || isAdmin()
      );
      allow list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // 전역 앱 설정
    match /app_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 플랫폼 후기 - rating은 1~5 정수만 허용
    match /platform_reviews/{reviewId} {
      allow read: if true;
      allow create: if hasVerifiedEmailIfRequired()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update: if hasVerifiedEmailIfRequired()
        && resource.data.userId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Q&A 게시판
    match /qna_posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn()
          && request.resource.data.userId == request.auth.uid;
        allow update: if isSignedIn()
          && resource.data.userId == request.auth.uid;
        allow delete: if isAdmin()
          || (isSignedIn() && resource.data.userId == request.auth.uid);
      }
    }

    // 정보 게시판
    match /info_posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn()
          && request.resource.data.userId == request.auth.uid;
        allow update: if isSignedIn()
          && resource.data.userId == request.auth.uid;
        allow delete: if isAdmin()
          || (isSignedIn() && resource.data.userId == request.auth.uid);
      }
    }

    // 튜터별 리뷰 - rating 1~5 정수만 허용
    match /tutor_reviews/{reviewId} {
      allow read: if true;
      allow create: if hasVerifiedEmailIfRequired()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update: if hasVerifiedEmailIfRequired()
        && resource.data.userId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // 이벤트 (프로모션·친구추천 등)
    // 모든 방문자 조회 가능, 작성/수정/삭제는 관리자만
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 결제 내역
    // create: 본인 결제 생성 시 status는 pending 고정, amount는 양의 정수
    // update: 관리자만 가능 (status/amount/referralRewarded 등 금전 관련 필드 보호)
    match /payments/{paymentId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid
        || resource.data.tutorId == request.auth.uid
        || isAdmin()
      );
      allow list: if isAdmin()
        || (isSignedIn() && resource.data.tutorId == request.auth.uid);
      allow create: if false;
      // 기존 주문은 관리자의 기존 처리 유지. 새 서버 주문의 금전성 필드는 클라이언트 수정 금지.
      allow update: if isAdmin() && (
        (resource.data.get('flowVersion', 1) != 2 && request.resource.data.get('flowVersion', 1) == resource.data.get('flowVersion', 1))
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userName', 'userEmail'])
      );
    }
  }
}
