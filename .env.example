# Toss Payments Configuration
# 클라이언트 키 (브라우저 노출 가능)
VITE_TOSS_CLIENT_KEY=your_toss_client_key_here
# 시크릿 키 (서버 전용, 절대 노출 금지)
TOSS_SECRET_KEY=your_toss_secret_key_here

# EmailJS Configuration
# 서비스 ID
VITE_EMAILJS_SERVICE_ID=
# 템플릿 ID
VITE_EMAILJS_TEMPLATE_ID=
# 퍼블릭 키
VITE_EMAILJS_PUBLIC_KEY=

# Firebase 브라우저 설정 (현재 Cloudflare Pages의 운영 값을 사용)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_DATABASE_ID=

# Firebase 서버 설정 (Cloudflare Pages Functions 전용)
# 서버 DB ID는 VITE_FIREBASE_DATABASE_ID와 반드시 같아야 함.
# firebase.json의 규칙 배포 대상은 ai-studio-d88729c3-7ce8-4749-a34f-6b30f0d26163.
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_ID=
FIREBASE_API_KEY=
FIREBASE_CLIENT_EMAIL=
# 서비스 계정 private_key. 서버 Secret으로만 저장, VITE_ 접두사 사용 금지.
FIREBASE_PRIVATE_KEY=
